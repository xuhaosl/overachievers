# 复制本文件为 .env 并按需修改（可选）

# 访问密码：留空 = 局域网内无需登录；设置后打开页面需先输入密码
# 适合把服务暴露到公网时开启
APP_PASSWORD=

# ---------- 数据与加密 ----------
# 数据目录（SQLite 与上传图片）。容器内默认 /app/data，本地默认项目根目录 data/
# DATA_DIR=/app/data

# API Key 加密主密钥。留空时自动在 DATA_DIR/.app_secret 生成并复用。
# 想固定主密钥（便于迁移）就设一个足够长的随机字符串；丢失后已存的 Key 无法解密。
# APP_SECRET=
# 或从文件读取主密钥
# APP_SECRET_FILE=

# ---------- 儿童隐私脱敏 ----------
# 默认脱敏级别：off / standard / strict
PRIVACY_LEVEL=standard
# 是否启用 AstrLink Guard 本地模型：auto（有模型文件与运行时就用）/ off
PRIVACY_GUARD_MODEL=auto
# AstrLink Guard 模型目录；留空则用 DATA_DIR/models/astrlink-guard
# ASTR_GUARD_DIR=

# ---------- CLI（客户端侧变量，服务端忽略） ----------
# OA_BASE_URL=http://127.0.0.1:8100
# OA_TOKEN=
